#   FL: +0.000 rps
# FL: count=23241, type=0x10, can=0x000F, data=c95a7fff7fff0104
#   FL: +0.000 rps
# FL: count=23241, type=0x10, can=0x000F, data=c95a7fff7fff0104
#   FL: +0.000 rps
# FL: count=23241, type=0x10, can=0x000F, data=c95a7fff7fff0104



import time
import serial

PORT = "/dev/ttyUSB0"
BAUDRATE = 921600

# 機体上の各モーターアドレス
MOTOR_IDS = {
    "FL": 0x0C,
    "FR": 0x14,
    "RL": 0x1C,
    "RR": 0x24,
}

ENCODER_REGISTER = 0x7019
COUNTS_PER_REV = 65536


def build_encoder_read_command(motor_addr: int) -> bytes:
    """既存プログラムと同じ、0x7019 の読出要求ATフレーム。"""
    reg = ENCODER_REGISTER
    return bytes([
        0x41, 0x54,             # "AT"
        0x90,                   # フレーム種別
        0x07, 0xE8,             # CAN ID
        motor_addr,             # モーターアドレス
        0x08,                   # データ長
        reg & 0xFF,             # レジスタ下位バイト: 0x19
        (reg >> 8) & 0xFF,      # レジスタ上位バイト: 0x70
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x0D, 0x0A,             # CR LF
    ])


def take_at_frames(buffer: bytearray):
    """受信バッファから完全なATフレームを順に取り出す。"""
    frames = []

    while True:
        start = buffer.find(b"AT")
        if start < 0:
            buffer.clear()
            break
        if start > 0:
            del buffer[:start]

        if len(buffer) < 9:
            break

        data_length = buffer[6]
        total_length = 7 + data_length + 2

        if len(buffer) < total_length:
            break

        if buffer[total_length - 2:total_length] != b"\r\n":
            del buffer[0]
            continue

        frame_type = buffer[2]
        can_id = (buffer[3] << 8) | buffer[4]
        motor_addr = buffer[5]
        data = bytes(buffer[7:7 + data_length])
        frames.append((frame_type, can_id, motor_addr, data))
        del buffer[:total_length]

    return frames


# 既存コードと同じモーターの判定方法
name_by_addr = {address: name for name, address in MOTOR_IDS.items()}
name_by_status_can_id = {address + 3: name for name, address in MOTOR_IDS.items()}


def motor_name(can_id: int, motor_addr: int) -> str | None:
    if can_id in name_by_status_can_id:
        return name_by_status_can_id[can_id]
    if (can_id & 0xFF) in name_by_status_can_id:
        return name_by_status_can_id[can_id & 0xFF]
    return name_by_addr.get(motor_addr)


previous = {}  # {モーター名: (エンコーダ値, 時刻)}

with serial.Serial(PORT, BAUDRATE, timeout=0.01) as ser:
    receive_buffer = bytearray()
    next_query_at = 0.0

    while True:
        now = time.monotonic()

        # 50 Hz で全モーターにエンコーダ値を要求
        if now >= next_query_at:
            for address in MOTOR_IDS.values():
                ser.write(build_encoder_read_command(address))
            next_query_at = now + 0.02

        # 到着済みのシリアルデータを読む
        waiting = ser.in_waiting
        if waiting:
            receive_buffer.extend(ser.read(waiting))

        for frame_type, can_id, motor_addr, data in take_at_frames(receive_buffer):
            name = motor_name(can_id, motor_addr)
            if name is None or len(data) < 2:
                continue

            # このプロジェクトの既定仕様:
            # ステータスフレームの先頭2バイトを little-endian uint16 として読む
            encoder_count = int.from_bytes(data[:2], "little")

            # 応答形式の確認用。最初は有効化して生データを見ると安全です。
            print(
                f"{name}: count={encoder_count:5d}, "
                f"type=0x{frame_type:02X}, can=0x{can_id:04X}, data={data.hex()}"
            )

            # 値の差分から回転速度[rps]を求める
            if name in previous:
                old_count, old_time = previous[name]
                delta = encoder_count - old_count

                # uint16値が 65535 → 0 をまたいだ場合を補正
                if delta > COUNTS_PER_REV / 2:
                    delta -= COUNTS_PER_REV
                elif delta < -COUNTS_PER_REV / 2:
                    delta += COUNTS_PER_REV

                dt = now - old_time
                if dt > 0:
                    rps = (delta / COUNTS_PER_REV) / dt
                    print(f"  {name}: {rps:+.3f} rps")

            previous[name] = (encoder_count, now)

        time.sleep(0.001)